@phdthesis{bergvall:87,
    author = {Bergvall, Victoria Lee},
    title = {Focus in Kikuyu and Universal Grammar (Bantu)},
    school = {Harvard University},
    pages = {234},
    year = {1987},
    abstract = {This dissertation examines a set of complex syntactic constructions in the Bantu language, Kikuyu, with respect to the use of the morpheme ne, within the framework of Government and Binding theory. Ne has variously been analyzed as a copula, a focus marker, and a preverbal predicator. I argue here that it shares all three functions, according to its structural placement. In each case, ne is generated in INFL. In its copular sense, it precedes a null verb form, in its preverbal predicator function, it precedes a verb, and in its focal function, it is part of a cleft with a null pleonastic subject, similar to an it-cleft in English. Arguing against an analysis of ne as a Focus morpheme, generated in COMP, I develop a theory of ne as an assertion marker which receives its focal force from its position in a cleft; the other two readings, I maintain, are not focal, but assertive. The cleft analysis extends naturally to encompass Extraposition, Pseudo-clefts, and a dependent clause clefting pattern, whose properties challenge the Focus in COMP analysis. In the examination of the constructions with ne, I also undertake a study of word order in Kikuyu, looking especially at the constructions Topicalization and Left-Dislocation, which are compared with the ne-focal cleft construction. I show that Topicalization and Left-Dislocation, can be collapsed into one rule, Left-Dislocation, because of the existence of a system of null pronominals for non-human objects. The dissertation concludes with a discussion of some theoretical ramifications for Government and Binding theory, particularly in X theory. This analysis crucially exploits the extension of maximal projections to INFL and COMP, but also raises problems in the attempt to integrate a category for the based-generated constituent in Left-Dislocation position. The principles by which an operator moves into a position where it can be governed for purposes of predication are also studied. I claim that not only is an analysis of ne in clefts possible and desirable, but it is the natural result of certain interworkings of the principles of GB theory.},
    citekeys = {cldf4:typ_Bergvall_Kikuyu},
    degree = {PhD},
    digital_formats = {PDF 7.99Mb image-only PDF},
    glottolog_ref_id = {76372},
    hhtype = {specific_feature},
    inlg = {English [eng]},
