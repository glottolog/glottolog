@article{yan:wang:etal:14,
    author = {Yan, Shi and Wang, Chuan-Chao and Zheng, Hong-Xiang and Wang, Wei and Qin, Zhen-Dong and Wei, Lan-Hai and Wang, Yi and Pan, Xue-Dong and Fu, Wen-Qing and He, Yun-Gang and Xiong, Li-Jun and Jin, Wen-Fei and Li, Shi-Lin and An, Yu and Li, Hui and Jin, Li},
    title = {Y Chromosomes of 40},
    journal = {PLOS ONE},
    publisher = {Public Library of Science},
    volume = {9},
    number = {8},
    pages = {1-7},
    year = {2014},
    url = {https://doi.org/10.1371/journal.pone.0105691},
    abstract = {Demographic change of human populations is one of the central questions for delving into the past of human beings. To identify major population expansions related to male lineages, we sequenced 78 East Asian Y chromosomes at 3.9 Mbp of the non-recombining region, discovered >4,000 new SNPs, and identified many new clades. The relative divergence dates can be estimated much more precisely using a molecular clock. We found that all the Paleolithic divergences were binary; however, three strong star-like Neolithic expansions at ∼6 kya (thousand years ago) (assuming a constant substitution rate of 1×10−9/bp/year) indicates that ∼40% of modern Chinese are patrilineal descendants of only three super-grandfathers at that time. This observation suggests that the main patrilineal expansion in China occurred in the Neolithic Era and might be related to the development of agriculture.},
    citekeys = {cldf11:yan14three},
    doi = {10.1371/journal.pone.0105691},
    glottolog_ref_id = {657104},
    isreferencedby = {cldf11},
    month = {08}
}
