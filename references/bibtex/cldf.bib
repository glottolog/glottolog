    isreferencedby = {cldf4},
    lgcode = {[limo1249]},
    macro_area = {North America},
    source = {DAI-A 60/06, p. 2008, Dec 1999},
    subject = {LANGUAGE, LINGUISTICS (0290)},
    umi_id = {9932722}
}
