    isreferencedby = {cldf4},
    lgcode = {[mokp1239]},
    macro_area = {Africa},
    source = {DAI-A 47/09, p. 3412, Mar 1987},
    subject = {LANGUAGE, LINGUISTICS (0290)},
    umi_id = {8624782}
}
