@mastersthesis{parker:88,
    author = {Parker, Stephen George},
    title = {Some Universal Aspects of Coalescence Processes Confirmed By Chamicuro Phonology and Morphology},
    school = {University of Texas at Arlington},
    pages = {120},
    year = {1988},
    abstract = {In this thesis the author presents an analysis of the Chamicuro language of Peru. Chamicuro is a member of the Maipuran branch of the Arawakan language family. The introduction notes that this is the first detailed study published on this nearly extinct language. A complete phonological analysis is presented, including both allophonic and morphophonemic processes. The major theoretical contribution of the work involves a presentation of several proposed universals relating to coalescence processes. Chapter four presents a sketch of certain aspects of Chamicuro morphology, focusing on noun phrases and verbs. The last chapter substantiates the Arawakan affiliation of the language. Finally, the appendix offers a list of nearly 700 Chamicuro words with English equivalents as an aid to anyone interested in studying the language further.},
    adviser = {Burquest, Donald},
