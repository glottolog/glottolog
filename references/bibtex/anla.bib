@misc{IN880M1880a,
    author = {Murdoch, John. and Murdoch, John. (compiler)},
    title = {Early accounts – John Murdoch},
    url = {http://www.uaf.edu/anla/item.xml?id=IN880M1880a},
    anlanote = {Photocopies.The folder contains (1) standardized charts developed by J.W. Powell, to be used in the field by students and others working with various American Indian languages. The set in the folder has the following information:Point Barrow Expedition; Tribe, Eskimos of Point Barrow and Cape Smythe; Locality, Arctic Alaska; Recorded by, 1st Lieut. P.H. Ray, 8th Infantry, A.S.Q. and Party; Date of record, September 1881 to August 1883.There are also various published word lists from the Point Barrow Expedition. Notes by Michael E. Krauss indicate the manuscript pages are a compendium of terms collected by Murdoch, Ray, Oldmixon, and Herendeen but written in Murdoch's hand, that Murdoch re-transcribed in the Powell orthography, and that this was printed, minus the sources distinctions in the original},
    anlclanguage = {Inupiaq},
    anlctype = {lexicon},
    citation = {(1) BAE ms. 304;(2) LCCN: 87009503 Ethnological results of the Point Barrow Expedition / John Murdoch ; introduction by William W. Fitzhugh. Washington, D.C. : Smithsonian Institution Press, 1988. Series Title: (Classics of Smithsonian anthropology) General Note: Reprint. Originally published: 1892. General Note: Documents related to the International Polar Expedition to Point Barrow, Alaska, 1881-83. General Note: "Reprinted from the Ninth annual report of the Bureau of Ethnology, 1887-88"--T.p. verso},
    glottolog_ref_id = {165015},
    lgcode = {Inupiaq [ipk]}
}
