@misc{IN825B1825,
    title = {Early explorations – Captain F. W. Beechey},
    url = {http://www.uaf.edu/anla/item.xml?id=IN825B1825},
    anlanote = {Photocopies.Frederick William Beechey (1796-1856) was a British Naval officer, geographer, and explorer. In 1825, Beechey was given command of the 'Blossom' and ordered to the Pacific to make surveys and to cooperate with Franklin and Parry who were searching for a Northwest Passage from the east. The 'Blossom' reached Kotzebue Sound on July 22, 1826. Surveys were made along the coast as far as Point Barrow before going to San Francisco until the end of the year. He again sailed to Bering Strait by way of Hawaii, China and Petropavlovsk, reaching Kotzebue Sound on August 5, 1827. The remainder of the season was spent surveying in the area around Seward Peninsula [information taken from the folder].The folder contains maps, reports, description and word lists gathered by Beechey.Includes handwritten notes by Michael E. Krauss},
    anlclanguage = {Inupiaq},
    anlctype = {ethnographic, lexicon, text-ethnographic},
    glottolog_ref_id = {164991},
    lgcode = {Inupiaq [ipk]}
}
