@misc{TS978T2000,
    author = {Tarpent, Marie-Lucie},
    title = {The Tsimshianic Languages in Historical and Areal Perspective},
    year = {2000-11-00},
    url = {http://www.uaf.edu/anla/item.xml?id=TS978T2000},
    anlanote = {The Tsimshianic Languages in Historical and Areal PerspectiveINTRODUCTION:"Sapir (1929) characterized "Tsimshian" as "a northernPenutian outlier" but also "probably profoundly influenced by Mosan." Recent research shows that the major structural features and the basic roots of Tsimshianic are indeedmost compatible with Penutian affiliation (T 1997, 2000). This is an overview of the other influences on Tsimshianic, which has been isolated from Penutian for a very longtime, and instead surrounded by Tlingit (North), Athapaskan (East), Haida (West), Wakashan (South). It may also have been at one time in closer contact with Salishan."ca.6},
