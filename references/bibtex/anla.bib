    year = {1983-08-00},
    url = {http://www.uaf.edu/anla/item.xml?id=HAM975En1983d},
    anlanote = {Central Topics in Masset Haida Phonology and Morphology3 folders, folder #2 and #3 are drafts and include correspondence letters"The view adopted in this monograph is that syllablestructure is the interface between morphology and phonology,being on the one hand the framework on which morphemic structures are hung and on the other the framework within which phonological rules operate. This view owes a great dealto the work of John McCarthy and to that of the many peoplewho have focused on the syllable in the last decade."ca.153},
    anlclanguage = {Haida},
