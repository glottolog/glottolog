@misc{CY972J1998,
    author = {Jacobson, Steven A},
    title = {Yup'ik Dialect Atlas and Study},
    year = {1998},
    url = {http://www.uaf.edu/anla/item.xml?id=CY972J1998},
    anlanote = {Book. A Central Yup'ik dialect study revealing patterns and transitions form one dialect to another, by village. Individual distribution maps make up the largest part of this study, but other sections feature isogloss maps, contour maps, word definitions, usages and derivations. 224 pp. Yup'ik Dialect Atlas and StudyThis book presents approx. 200 maps showing the distribution of Yup'ik nouns and verbs for items (animals, implements, anatomy) or verbal concepts for which two or more terms (or pronunciations of one term) are used. If more than a single form is used in a given location (village) the map show which form is commonest or whether they are used in different contexts, or by different age groups. Following this individual isogloss maps composite isogloss maps delineate the Central Yup'ik dialects, subdialects and transitional areas, and further maps illustrate the degree of similarity between villages representative of each dialect and their neighbors. One can see which dialects include a number of places and which are limited to one or a very few villages. Also one can see how three of the divergent dialects are related to each other, giving substance to nineteenth century accounts of the widely disbursed “Aglurmiut” subgroup of Central Yup'ik Eskimos. Included also is a description of the methodology of the dialect survey which was conducted in the 1980s funded by a grant from the Univ. of Alaska.ISBN 1-55500-066-5 This book is a useful complement to the Yup'ik Eskimo Dictionary by S. Jacobson, CA972J1984.Also in collection: Drafts, original isogloss maps and dialect maps with annotations},
    anlclanguage = {Yup'ik-Central-Alaskan},
    anlctype = {dialects},
    citation = {Fairbanks, Alaska Native Language Center, University of Alaska Fairbanks},
    comments = {Original maps are foldered. Drafts are in storage.Description by S.Jacobson 2011},
    format = {Text},
    glottolog_ref_id = {162066},
    lgcode = {Yup'ik-Central-Alaskan}
}
