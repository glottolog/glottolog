@misc{HAM975En1983c,
    author = {Enrico, John},
    title = {The Fire as Conduit to the Other World: A Note on Haida Deixis and Haida Belief},
    year = {1983-11-00},
    url = {http://www.uaf.edu/anla/item.xml?id=HAM975En1983c},
    anlanote = {The Fire as Conduit to the Other World: A Note on Haida Deixis and Haida Belief"The Haida aystem of spatial deixis is realized througha set of thriteen directional suffixes occurring directlyafter the verb stem, a set of relational nouns2 basicallydenoting locations and occurring in combination with postpositions and nominal specifiers to denote directions and relative locations 'e.g., *iid 'down' (locational), *iid-ga 'down' (motional), NP *id-gu 'under NP' (locational), NP *id-gwii 'under NP" (motional\guillemetright , a set of demonstrative determiners, and two other verb suffixes denoting the type of extension of the activity denoted by the verb (-daal 'extended in one dimension (a line)', -gwaang 'extended in two dimensions (a plane)'). I am concerned here only with two of the directional suffixes and their associated relational nouns:-gahl-sa*'addiid'toward the edge of a clear space' (towardthe land when at sea, inland or into theforest from the beach, toward the edge ofa room, toward the edge of a clearing ormuskeg},
    anlclanguage = {Haida},
    anlctype = {grammatical, traditional},
    format = {Text},
    glottolog_ref_id = {168395},
    lgcode = {Haida [hai]}
}
@misc{HAM975En1983d,
