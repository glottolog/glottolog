@misc{EY791M1791,
    author = {Malaspina, Alejandro},
    title = {Eyak Word "tejun" and comments; primarily Malaspina expedition notes},
    year = {1791},
    url = {http://www.uaf.edu/anla/item.xml?id=EY791M1791},
    anlanote = {Alejandro Malaspina (Malaspina di Mulazzo, Alessandro) (1754-1809) was a Sicilian mariner and explorer, in Spanish service. In 1789, Malaspina was given command of a round-the-world scientific and exploration expedition. It was to be a Spanish version of the expeditions of LaPerouse and Cook. On June 2, the expedition arrived on the Alaska coast near present-day Sitka, and explored as far as Prince William Sound. They examined Mount St. Elias and Yakutat Bay, before returning to Spain. The material includes excerpts from Antonio de Tova and Felipe Bauza, who gave very brief descriptions of the people they saw and the language they heard in their journals.Much of the source material is in Spanish. The folder includes notes by Leer and Krauss, correspondence with Wallace Olson and others, and copies of materials published and unpublished.The discussion centers around the word 'tejeunes' or human being, person.Material is taken from various Spanish documents},
    anlclanguage = {Eyak},
    anlctype = {ethnographic, lexicon, text-ethnographic},
    format = {Text},
    glottolog_ref_id = {174453},
    lgcode = {Eyak [eya]}
}
