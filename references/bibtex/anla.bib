@misc{IN977Anon1977b,
    title = {Ephemera – The Management of Change [OCS},
    year = {1977},
    url = {http://www.uaf.edu/anla/item.xml?id=IN977Anon1977},
    anlanote = {Book."OCS impact is here. Now, long before the first drill bit chews its way into new areas of Alaska's Outer Continental Shelf, coastal communities and villages know what impact is. Residents feels pressures and anxieties...The Alaska Native Foundation and the Alaska Native Human Resource Development project chose 'The Management of Change' as the theme of a three-day conference for residents of rural communities, including sessions on what OCS means and how you can control it. That was the first step. Next comes local organizing and decision-making. Then planning and focusing on the future. And dealing with oil companies and development and change. This is a report on that process. [pp. 2-3]"The report explains primarily in English but parts of it are in Yupik and Inupiaq.OCS=Outer Continental Shelf},
    anlctype = {text},
    citation = {LCCN: wln78041460 The Management of change. [Anchorage : Alaska Native Foundation and the Kellogg Project, 1977] Physical descrip: 24 p. : ill. ; 21 x 27 cm. Subject term: Coastal zone management–Alaska. Subject term: Villages–Alaska. Added author: Alaska Native Foundation},
