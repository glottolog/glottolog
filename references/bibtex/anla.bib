@misc{AL938A1938,
    author = {Anonymous},
    title = {Abridged Lenten Triodon and Pentecostarion: Hymns of Holy Week, Pascha, Ascension},
    year = {1938},
    anlanote = {Date uncertain. "This 152 page Day Book contains entries on pages 1, 3, 5, 7, 9, and 152. The front end-paper says, "Kashega Church Book." The back end-paper refers to George Borenin and Cornelius Kudrin, the two men who resettled Kashega Village following World War II. George Borenin was the last chief of Kashega and a reader in the church. The book was among possessions of Phil Tutiakoff and may have been given to his mother, Anfesia Shapsnikoff. Xeroxed by permission of Flora Tutiakoff. Note: The page number '1' on the first page has been altered into 1938. However, the names on the back end-paper were written in 1958 or 1960." Also in collection: 1 p. description of the church book, and 1 p. letter from M. Krauss to Ray Hudson. 8 pp.Additional descriptive information provided by ASNA:The contents of the "Kashega Church Book" are selected hymns from the Lenten Triodion (Hymns of the Lenten season before Pascha/Easter) and Pentecostarion (Hymns of the 7 weeks after Pascha/Easter), and are as follows (as found in the manuscript):Reading of the Twelve Passion Gospels read on Holy Thursday night(officially part of Holy Friday Matins)- Antiphon 6, Sedalen (Kathisma)- Antiphon 9, Sedalen (Kathisma)- Antiphon 12, Sedalen (Kathisma)- Troparion, which is the same as the Sedalen (Kathisma) of Antiphon 15Holy Friday Vespers- On "Lord, I have called" verses- After "Glory, and Now" of the Sitkhovne Stikhiri (Aposticha)Feast of Pascha (Easter):- Troparion "Christ is Risen"- Concluding Hymn "I nam darovav zhivot vechni" ("And gave us life eternal")- Hypakoe- KontakionFeast of Ascension (40 days after Pascha):- TroparionProkimena of Holy Thursday VespersProkimena of Holy Friday Vespers},
    anlclanguage = {Aleut (Unangan)},
    anlctype = {text-religious},
    collection = {ASNA},
    comments = {Typeset by All Saints of North America Orthodox Church http://www.asna.ca},
    file = {triodion-pentecostarion-TYPESET.pdf},
    format = {application/pdf},
    glottolog_ref_id = {173439},
    lgcode = {Aleut [ale]}
}
