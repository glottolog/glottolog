@misc{CY972J1984,
    author = {Jacobson, Steven A. (compiler)},
    title = {Yup'ik Eskimo Dictionary},
    year = {1984},
    url = {http://www.uaf.edu/anla/item.xml?id=CY972J1984},
    anlanote = {Book shelved with dictionaries.Definitive bilingual dictionary of the Central Alaskan Yup'ik language. Bases, postbases, and endings, as well as an English finderlist and numerous appendices. Yup'ik Eskimo DictionaryThe Yup'ik Eskimo Dictionary (YED) is a native language to English dictionary of the Central Yup'ik Eskimo language of Southwestern Alaska (the Yukon-Kuskokwim Delta, Bristol Bay and adjoining areas). It covers the lexicon of the majority dialect of Central Yup'ik with its various sub-dialects, plus divergent dialects such as that of Nunivak Island which is sometimes considered a language in its own right (and even has its own dictionary, published by ANLC). Words specific to certain dialects or sub-dialects are noted as such.An introduction describes the Yup'ik Eskimo phonology and the way it is represented by the standard orthography which is used in the dictionary, the format of the entries and of the dictionary as a whole, the various dialect indications and the main characteristics of each dialect, the problem of disappearing initial “0” on words, and various other issues. Also covered is the history of the lexicography of Central Yup'ik Eskimo in general and of this dictionary in particular.Nouns are given in their absolutive singular forms while verbs are given as abstract bases translated by infinitives, but the third person singular subject intransitive and transitive forms along with translations are listed immediately thereafter. Most dictionary entries have several translated examples of use. The dictionary's alphabetical organization is by main-base entry with forms derived from such bases listed under it as subentries. Where determinable the suffixes involved in each such derivation are indicated. The origin of loan words (from Russian, English, Athabaskan, etc.) is given.Following the section on bases is an alphabetical listing of the two types of suffix, postbases and enclitics, whether they are actively usable or only historically determinable, Tables of inflectional endings (noun cases, and verb moods) are also given.Appendices include charts of inflected forms of demonstratives and personal pronouns, labeled drawings of a dogsled, parka, kayak, and traditional house, lists of loan words, numerals, month names, positional bases, several types of verb roots (obligatorily used with certain postbases), and lists of as yet unverified and/or unidentified forms from several old word-lists.There is an alphabetized English to Yup'ik index or finder list.The YED was published by ANLC in 1984. A new, expanded and revised edition of the YED is almost ready for publication. The dictionary was funded by grants from NEH and NSF.Box 1 of 2 Yup'ik Eskimo Dictionary,1980 draft annotated by Irene Reed.Box 2 of 2 Yup'ik Eskimo Dictionary,1980 draft annotated by Lucy Coolidge.Also in collection: 4 boxes of drafts and edited drafts of the dictionary in storage in the ANLA Annex},
    anlclanguage = {Yup'ik-Central-Alaskan},
    anlctype = {dialects, lexicon},
    citation = {Description by S. Jacobson 2011},
    collection = {Dictionaries},
    comments = {F. 1-12 collected by Steve Jacobson, moved from binders in Steves office to report covers in Dec. 2010. WC},
    coverage = {Lower Kuskokwim},
    format = {application/pdf},
    glottolog_ref_id = {114649},
    lgcode = {Yup'ik-Central-Alaskan},
    restrictions = {Digital file for archive purposes only; not for public distribution}
}
@misc{CY972J1984b,
    author = {Jacobson, Steven A},
    title = {Semantics and Morphology of Demonstratives in Central Yup'ik Eskimo},
    year = {1984},
    url = {http://www.uaf.edu/anla/item.xml?id=CY972J1984b},
    anlanote = {Ts offprint. 8 pp.The complex demonstrative systems of Eskimo languages have long fascinated observers of Eskimo language and culture and Yup'ik has perhaps the fullest demonstrative system of any Eskimo language, containing more than two dozen distinct bases for locating things in space. This paper systematizes and explains the semantics and morphology of demonstrative bases in Central Yup'ik. Their relationship to verbs of motion is discussed, and irregularities in the demonstrative system are fully considered},
    anlclanguage = {Yup'ik-Central-Alaskan},
    anlctype = {grammatical},
    citation = {Etudes/Inuit/Studies, 1984 p 185-192},
    format = {Text},
    glottolog_ref_id = {166329},
