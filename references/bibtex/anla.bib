    title = {Selected Jochelson texts},
    year = {1985},
    url = {http://www.uaf.edu/anla/item.xml?id=AL972K1985b},
    anlanote = {Folder 1: (1) Cagaxcxínax (The Amulet Searcher). Jochelson text, typescript, and abstract. (2) Iráyar Lived There. Jochelson text, abstract, and text from Bergsland's Aleut Dialects of Atka and Attu. (3) A Man There Lived. Jochelson text, typescript, Bergsland Atka and Attu text. (4) Misisagux^. Jochelson text, typescript, abstract, and Bergsland Atka and Attu text. Folder 2: (5) Qaglamigúyax' (The Big Raven). Jochelson text, typescript, abstract, and Bergsland Atka and Attu text. (6) Qagláx' (Raven). Jochelson text, typescript, abstract. (7) Inigam Annáca (Blanket Tossing Song). Typescript. (8) Tayágux^-Kayulinax^. Translation into Russian. (9) Miichim aliguu. (10) Igutaaga. Atkan text recited by Peter Khoroshev on phonograph cylinders, 1909 transcribed by Moses Dirks, 1985. (11) 11 illustrations, source unknown, and 1 p. note to Lydia Black},
    anlclanguage = {Aleut (Unangan)},
    comments = {Folder marked, "Krauss - for J. Paper." Item catalogued based on probability that this collection was research for a paper being written by M. Krauss. Cf. AL972K1985a. Paper does not make use of materials in this folder… Cf. AL909J1925a for Jochelson texts and AL950B1959 for Bergsland Atka and Attu texts},
    format = {Text},
    glottolog_ref_id = {173642},
    lgcode = {Aleut [ale]}
}
