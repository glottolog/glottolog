@misc{TS978M1986,
    author = {Mulder, Jean},
    title = {Structural Organization in Coast Tsimshian Music},
    year = {1986},
    url = {http://www.uaf.edu/anla/item.xml?id=TS978M1986},
    anlanote = {Structural Organization in Coast Tsimshian Music"The aim of this paper is to explore one of the facets of language in its social setting: that of singing. The focus is a linguistic analysis of the verbal and musical components of 20 songs and dances to show ways that they may yield new knowledge of the structure of Coast Tsimshian music. In particular it will be shown that the songs have well-definedpatterns of structural organization and that non-lexical syllables have a specific structural function in defining these patterns."ca.17},
