@misc{TL004C2010b,
    author = {Crippen, James},
    title = {Multiple Correspondences in Tlingit Consonants with Proto-Athabaskan-Eyak},
    year = {2010-01-04},
    url = {http://www.uaf.edu/anla/item.xml?id=TL004C2010b},
    anlanote = {Multiple Correspondences in Tlingit Consonants with Proto-Athabaskan-EyakAbstract"Tlingit is generally accepted as one of the two primary branches of the Na-Dene family, with the other being Athabaskan-Eyak. A major problem in the reconstruction of Proto-Na-Dene is that Proto-Athabaskan-Eyak forms oftenhave multiple cognates in Tlingit, with relatively regular but unexplained alternations in consonants, vowels, or both. This phenomenon presents a difficult challenge to the comparative method despite copious data in favor ofthe relationship. In this article I review the basic arguments for Tlingit being a Na-Dene language and illustrate most of the multiple correspondencesbetween Proto-Athabaskan-Eyak and Tlingit. Finally I summarize the few explanations which have been offered for this phenomenon."ca.53},
    anlclanguage = {Comparative Athabaskan Tlingit},
    anlctype = {comparative},
    format = {application/pdf},
    glottolog_ref_id = {167915},
    lgcode = {, Tlingit [tli]}
}
