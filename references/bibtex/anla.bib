@misc{AL772P1777,
    author = {Pallas, Peter Simon},
    title = {Aleut wordlist},
    year = {1777},
    url = {http://www.uaf.edu/anla/item.xml?id=AL772P1777},
    anlanote = {Earliest Aleut wordlists and earliest Alaskan wordlist. (1) Copied by Adelung from a letter by Pallas to Backmeister, 11 nouns and numerals 1-10, most probably (v. Bergsland 1959.6) taken by Pallas perhaps from Dmitri Bragin at Irktsk, March 1772. (2) First printing, in volume 3 of German original and both translations, 1777; German edition of 1777, p. 362; French edition of 1777, p. 117 (and Russian edition of 1789, pt. 3, p. 85-86) has numerals 1-10 and 9 nouns. (3) 12 nouns and numerals 1-10, 2 or 3 terms evidently from Glotov in J.L.S., with remark that the language is different from Koryak, Kamchadal, Ainu. (4) 9 nouns, 2 not in (3), and numerals 1-10, compared with Greenlandic and (Canadian) Eskimo; (5) English translation of (4)},
    anlclanguage = {Aleut (Unangan)},
    anlctype = {lexicon},
    comments = {Folder 1 (f.1) = (1), (3)-(5). Folder 2 (f.2) = (2). Also in collection: Folder 1: Handwritten bibliographic entry and notes by Krauss?, 5 pp.; p. 6 of Bergsland 1959, Introduction: Sources and Informants: Eighteenth-Century Material. Brief history of Aleut data collection in the 18th century.; p. xxxviii of Bergsland's Aleut Dictionary 1994. Summary of Pallas' observations.; notes, 1 p; 10 Aleut numerals from Peter S. Pallas, Navigantum atave Itinerantium Bibl-. In Starr, Jerome Lincoln. The Cultural and Educational Development of Aborigines and Settlers in Russian America, 1784-1867. PhD Dissertation, New York University, 1961. 1 p.; bibliographic entry from UA Libraries Catalog for Navigantium atave itinerantium bibliotheca, by John Harris, 1 p. and notes, Krauss?; handwritten bibliographic entry for AL772P1780 and notes, Krauss?, 1 p.; biographies on Bragin, Dmitri (1 p.), Pallas, Peter Simon (1 p.), Coxe, William (2 pp.) from unknown source; title page of Neue Nachrichten von denen neuentdekten Insuln in der See zwischen Asien und Amerika by J.L.S., published Hamburg und Leipzib: ben Friedrich Ludwig Gleditsch, 1776.; Biographical entry for Schultz, Johann Ludwig from unknown source, 1 p.; 2 pp. of German from Yale; bibliographic entry from OCLC First Search for Neue Nachrichten…, 2 pp. Folder 2: Notes by Krauss? about the Russian edition.; bibliographic entries from OCLC First Search (http://newfirstsearch.oclc.org) of contents of (2), 15 pp.; Misc. bibliographic entries on Georgi, origin unknown, 8 pp.; OCLC First Search bibliographic entries of Bemerkungen ziner Reise im Russischen im Jahre 1772, [in den Jahren 1773 und 1774], 5 pp.; Title page, 4 pp. of Bemerkungen…; UA Library catalog entry for Bemerkungen…, 1 p.; biography of Georgi, source unknown, 2 pp.; Historiya Russkoi Ethnografii. S. A. Tokarev. Moskva: Iedatelstvo <Naika>, 1966. pp. 94-97, pp. 102 - 111 and title page (15 pp.)Not in Folder 2: Russian edition 1776-1777; English edition},
    format = {Text},
    glottolog_ref_id = {173129},
    lgcode = {Aleut [ale]}
}
@misc{AL772P1811,
    author = {Pallas, Peter Simon},
    title = {Krauss' notes on] Zoographica Rosso-Asiatica},
    year = {1811},
    url = {http://www.uaf.edu/anla/item.xml?id=AL772P1811},
    anlanote = {The Zoographica is a three volume book with Aleut words throughout. The microfiche is in the Rasmusen Library: QL331.P16 MFICHE; the volumes are not in the ANLC Archive. This folder contains a list of Aleut terms extracted by Krauss, 1982, 1 p. ms. including about 50 Aleut mammal, bird, and fish names. Perhaps mostly from Merck, but forms here are not the same as on any known Merck (or Robek) list. Sedentary Chukchi (Naukan), 3 items definitely from Robek 1791 ms. (see AL791R1791). Also in folder: handwritten draft bibliographic entry, 1 pp.; handwritten description of word list, 1 pp.; handwritten note to Knut Bergsland from M. Krauss, 1 p.; 2 annotated copies of Krauss' extracted word list; biographies of Chamisso, Ludovik-Charles-Adelaid de (2 pp.) and Chonis, Ludwig (1 pp.) from unkown source},
    anlclanguage = {Aleut (Unangan)},
    anlctype = {lexicon},
    glottolog_ref_id = {173126},
    lgcode = {Aleut [ale]}
}
