@misc{AL983L1987b,
    author = {Leer, Jeff},
    title = {The Relative Case in Aleut},
    year = {1987},
    url = {http://www.uaf.edu/anla/item.xml?id=AL983L1987b},
    anlanote = {Ts. Summary;The relative case marks an overt possessor, and in a sentence with 'normal' word order, it marks an overt subject of a clause whose predicate contains , in which case also the verb heading (of) the clause takes a 2 party suffix... I maintain that the facts of Aleut syntax do not follow from the assumption that Aleut is an 'ergative' language. I further argue that the behavior of indefinite NPs in sentences with local complements cannot be explained in terms of Topicalization, and propose rules of Inversion and Reversion to account for the data at hand. Finally, I discuss the exceptional case of the affirmative existential construction, concluding that it could be considered a 'lexicalized' syntactic construction},
    anlclanguage = {Aleut (Unangan)},
    anlctype = {grammatical},
    comments = {See also: CY973J1970b f.16 for a copy given to Steven Jacobson},
    format = {Text},
    glottolog_ref_id = {173700},
    lgcode = {Aleut [ale]}
}
