@misc{IN-N-974K1981,
    author = {Kaplan, Lawrence D},
    title = {Kaplan – North Slope Inupiaq Literacy Manual},
    year = {1981},
    anlanote = {Book.From the introduction:This manual is designed to be used in the teaching of writing to Alaskan Inupiaq speakers. Two versions of the manual have been produced so far: one for the Kobuk dialect and another for the North Slope dialect...The purpose of this material is to help increase the literacy skills of Inupiaq people in their own language. "Literacy skills" means reading and writing. The first step in learning to write is learning to spell, and spelling is what is emphasized in this manual...Once spelling is learned, students will go on to write in Inupiaq as a means of expression...The manual includes teacher's notes for each chapter and exercises for the students},
    anlclanguage = {Inupiaq},
    anlctype = {educational, orthography, phonology},
